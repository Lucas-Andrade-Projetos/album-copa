# Copie este arquivo para .env e preencha os valores reais.
# O arquivo .env NUNCA deve ser commitado no git.

# Chave secreta para assinar cookies de sessão.
# Gere uma com: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=troque-por-uma-chave-aleatoria-longa

# Quantos pacotes o usuário pode abrir por dia (padrão: 5)
PACKS_PER_DAY=5

# Quantas figurinhas vêm em cada pacote (padrão: 5)
STICKERS_PER_PACK=5
